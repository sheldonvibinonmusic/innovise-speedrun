# ==============================================================================
# Environment Configuration Template (Example only - DO NOT commit real secrets)
# Copy this file to .env and provide your local configuration values.
# ==============================================================================

# Application Environment & Server Settings
APP_NAME=Trustworthy Multi-Agent Financial Research System
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
HOST=127.0.0.1
PORT=8000
FRONTEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistence & Storage
DATABASE_URL=sqlite:///./data/financial_research.db
UPLOAD_DIR=./data/uploads
RAW_DIR=./data/raw
PROCESSED_DIR=./data/processed
QDRANT_PATH=./data/qdrant

# Model & LLM Provider Configuration (Optional for Phase 1)
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-2.5-pro
LLM_API_KEY=your_api_key_here

# SEC EDGAR Source Connector (SEC requires 'Sample Company Name AdminContact@<sample company domain>.com')
SEC_USER_AGENT=FinancialResearchSystem user@example.com

# System Limits & Safety Bounds
MAX_UPLOAD_MB=25
MAX_RESEARCH_RETRIES=3
MAX_CONCURRENT_RUNS=2
